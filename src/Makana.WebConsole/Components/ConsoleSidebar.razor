@using Makana.WebConsole.Components
@using Makana.WebConsole.Models
@using Microsoft.AspNetCore.Routing
@inject LinkGenerator LinkGenerator
@inject IHttpContextAccessor HttpContextAccessor

<aside id="console-sidebar" data-sidebar aria-label="Primary navigation">
    <header class="vstack gap-2">
        <div class="vstack gap-1">
            <strong>Makana</strong>
            <small class="text-light">Pulumi Console MVP</small>
        </div>
        <ot-dropdown>
            <button type="button"
                    class="outline small flex items-center justify-between gap-2 w-100"
                    popovertarget="owner-menu"
                    aria-label="Switch owner">
                <span>@SelectedOwnerLabel()</span>
                <DropdownChevron />
            </button>
            <menu popover id="owner-menu" class="owner-menu">
                @foreach (var group in Context.OwnerGroups)
                {
                    <section class="owner-menu-group" aria-label="@group.Heading">
                        <header class="owner-menu-heading">@group.Heading</header>
                        @foreach (var owner in group.Options)
                        {
                            <a role="menuitem"
                               href="@OwnerSwitchHref(owner.Value)"
                               aria-current="@(IsSelectedOwner(owner.Value) ? "page" : null)">@owner.Label</a>
                        }
                    </section>
                    <hr />
                }
                <a role="menuitem"
                   href="@OwnerPageHref("/Organizations/Create")">
                    Create organization
                </a>
            </menu>
        </ot-dropdown>
    </header>

    <nav class="vstack gap-4" aria-label="Primary navigation">
        <ul>
            <li><a href="@OwnerPageHref("/Index")" aria-current="@AriaCurrent("Dashboard")">Dashboard</a></li>
            <li><a href="@OwnerPageHref("/Stacks/Index")" aria-current="@AriaCurrent("Stacks")">Stacks</a></li>
            <li><a href="@OwnerPageHref("/Resources/Index")" aria-current="@AriaCurrent("Resources")">Resources</a></li>
            <li><a href="@OwnerPageHref("/Environments/Index")" aria-current="@AriaCurrent("Environments")">Environments</a></li>
            <li><a href="@OwnerPageHref("/Deployments/Index")" aria-current="@AriaCurrent("Deployments")">Deployments</a></li>
            <li><a href="@OwnerPageHref("/AiTasks/Index")" aria-current="@AriaCurrent("AiTasks")">AI Tasks</a></li>
        </ul>

        <ul>
            <li><a href="@OwnerPageHref("/Platform/Index")" aria-current="@AriaCurrent("Platform")">Platform</a></li>
            <li><a href="@OwnerPageHref("/Settings/Index")" aria-current="@AriaCurrent("Settings")">Settings</a></li>
        </ul>
    </nav>
</aside>

@code {
    [Parameter, EditorRequired]
    public ConsoleNavigationContext Context { get; set; } = ConsoleNavigationContext.Empty;

    [Parameter]
    public string ActiveSection { get; set; } = string.Empty;

    private bool IsSelectedOwner(string ownerValue)
        => string.Equals(ownerValue, Context.SelectedOwner, StringComparison.Ordinal);

    private string? AriaCurrent(string section)
        => string.Equals(section, ActiveSection, StringComparison.Ordinal) ? "page" : null;

    private string OwnerPageHref(string page)
        => OwnerPageHref(page, Context.SelectedOwner);

    private string OwnerPageHref(string page, string owner)
        => PageHref(page, new { owner });

    private string OwnerSwitchHref(string owner)
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is null)
        {
            return "#";
        }

        var currentPage = httpContext.GetRouteValue("page")?.ToString();
        var target = ConsoleOwnerSwitchTargetResolver.Resolve(owner, currentPage, httpContext.Request.RouteValues);
        return PageHref(target.Page, target.RouteValues);
    }

    private string SelectedOwnerLabel()
    {
        var selected = Context.OwnerOptions.FirstOrDefault(option =>
            string.Equals(option.Value, Context.SelectedOwner, StringComparison.Ordinal));
        return selected?.Label ?? Context.SelectedOwner;
    }

    private string PageHref(string page, object? values = null)
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is null)
        {
            return "#";
        }

        var routeValues = new RouteValueDictionary(values);
        var path = LinkGenerator.GetPathByPage(
            httpContext: httpContext,
            page: page,
            values: routeValues.Count > 0 ? routeValues : null);
        return string.IsNullOrWhiteSpace(path) ? "#" : path;
    }
}
