@using Makana.WebConsole.Models
@if (Projects.Count == 0)
{
    <article class="card align-center">
        <header>
            <h3>No projects found</h3>
            <p class="text-light">Create a stack with the Pulumi CLI to populate this view.</p>
        </header>
    </article>
}
else
{
    foreach (var project in Projects)
    {
        <ProjectStackCard Project="project" SelectedOwner="@SelectedOwner" />
    }
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectGroupSummary> Projects { get; set; } = [];

    [Parameter]
    public string SelectedOwner { get; set; } = string.Empty;
}
