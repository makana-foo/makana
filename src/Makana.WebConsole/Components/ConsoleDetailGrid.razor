@using Makana.WebConsole.Models

@if (Items.Count > 0)
{
    <dl class="console-detail-grid @ClassName">
        @foreach (var item in Items)
        {
            <div class="console-detail-grid__item">
                <dt>@item.Label</dt>
                <dd>@item.Value</dd>
            </div>
        }
    </dl>
}

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<ConsoleDetailItem> Items { get; set; }

    [Parameter]
    public string ClassName { get; set; } = string.Empty;
}
