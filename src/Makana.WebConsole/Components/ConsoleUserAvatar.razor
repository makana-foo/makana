@namespace Makana.WebConsole.Components

@if (!string.IsNullOrWhiteSpace(AvatarPath))
{
    <figure data-variant="avatar" class="@SizeClass" title="@AltText" aria-hidden="true">
        <img src="@AvatarPath" alt="@AltText" width="@Size" height="@Size" />
    </figure>
}

@code {
    [Parameter, EditorRequired]
    public string AvatarPath { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string AltText { get; set; } = string.Empty;

    [Parameter]
    public int Size { get; set; } = 28;

    private string SizeClass => Size >= 48
        ? "large"
        : Size <= 32
            ? "small"
            : string.Empty;
}
