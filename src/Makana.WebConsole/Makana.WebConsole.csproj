    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.5" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Solacon" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Makana.ServiceDefaults/Makana.ServiceDefaults.csproj" />
    <ProjectReference Include="../Makana.StackUpdates/Makana.StackUpdates.csproj" />
    <ProjectReference Include="../Makana.Compatibility/Makana.Compatibility.csproj" />
  </ItemGroup>

