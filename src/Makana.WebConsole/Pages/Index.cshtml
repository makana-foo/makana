@page
@model Makana.WebConsole.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["NavSection"] = "Dashboard";
}

<section>
    <header>
        <h1>Dashboard</h1>
        <p>Overview for <strong>@Model.Owner</strong>.</p>
    </header>

    <div class="dashboard-stats" role="list" aria-label="Owner summary">
        <article role="listitem">
            <header>Projects</header>
            <p><strong>@Model.ProjectCount</strong></p>
        </article>
        <article role="listitem">
            <header>Stacks</header>
            <p><strong>@Model.Context.SelectedOwnerStacks.Count</strong></p>
        </article>
        <article role="listitem">
            <header>Resources</header>
            <p><strong>@Model.ResourceCount</strong></p>
        </article>
    </div>
</section>

<section>
    <h2>Recent stacks</h2>
    @if (Model.RecentStacks.Count == 0)
    {
        <p>No stacks yet for this owner.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th scope="col">Project</th>
                    <th scope="col">Stack</th>
                    <th scope="col">Last update</th>
                    <th scope="col">Resources</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var stack in Model.RecentStacks)
            {
                <tr>
                    <td>@stack.ProjectName</td>
                    <th scope="row">
                        <a asp-page="/Stacks/Details"
                           asp-route-org="@stack.OrgName"
                           asp-route-project="@stack.ProjectName"
                           asp-route-stack="@stack.StackName"
                           asp-route-owner="@Model.Owner">
                            @stack.StackName
                        </a>
                    </th>
                    <td>@FormatTime(stack.LastUpdate)</td>
                    <td>@(stack.ResourceCount?.ToString() ?? "-")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

@functions {
    private static string FormatTime(long? unixTimestamp)
    {
        if (!unixTimestamp.HasValue || unixTimestamp.Value <= 0)
        {
            return "No updates";
        }

        var value = unixTimestamp.Value > 1000000000000
            ? DateTimeOffset.FromUnixTimeMilliseconds(unixTimestamp.Value)
            : DateTimeOffset.FromUnixTimeSeconds(unixTimestamp.Value);
        return value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }
}
