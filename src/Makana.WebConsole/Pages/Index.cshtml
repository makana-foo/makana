@page "/{owner}"
@model Makana.WebConsole.Pages.IndexModel
@using Makana.WebConsole.Models
@{
    ViewData["Title"] = "Dashboard";
    ViewData["NavSection"] = "Dashboard";
    var pageHeader = new ConsolePageHeaderViewModel(
        "Dashboard",
        $"Overview for {Model.Owner}.");
}

<section class="dashboard-page">
    <partial name="_ConsolePageHeader" model="pageHeader" />

    <div class="dashboard-page__summary" role="list" aria-label="Owner summary">
        <div role="listitem">
            <component type="typeof(Makana.WebConsole.Components.ConsoleSummaryCard)"
                       render-mode="Static"
                       param-Title="@("Projects")"
                       param-Value="@Model.ProjectCount.ToString()"
                       param-Description="@("Distinct Pulumi projects for this owner.")" />
        </div>
        <div role="listitem">
            <component type="typeof(Makana.WebConsole.Components.ConsoleSummaryCard)"
                       render-mode="Static"
                       param-Title="@("Stacks")"
                       param-Value="@Model.Context.SelectedOwnerStacks.Count.ToString()"
                       param-Description="@("Stacks currently visible in this workspace.")" />
        </div>
        <div role="listitem">
            <component type="typeof(Makana.WebConsole.Components.ConsoleSummaryCard)"
                       render-mode="Static"
                       param-Title="@("Resources")"
                       param-Value="@Model.ResourceCount.ToString()"
                       param-Description="@("Tracked resources across the selected owner.")" />
        </div>
    </div>
</section>

<section class="dashboard-page__section">
    <h2>Recent stacks</h2>
    @if (Model.RecentStacks.Count == 0)
    {
        <partial name="_ConsoleEmptyState" model='new ConsoleEmptyStateViewModel("No stacks yet for this owner.")' />
    }
    else
    {
        <div class="table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Project</th>
                        <th scope="col">Stack</th>
                        <th scope="col">Last update</th>
                        <th scope="col">Resources</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var stack in Model.RecentStacks)
                {
                    var stackPath = ConsoleRoutePaths.Stack(Model.Owner ?? string.Empty, stack.ProjectName, stack.StackName);
                    <tr>
                        <td>@stack.ProjectName</td>
                        <th scope="row">
                            <a href="@stackPath">@stack.StackName</a>
                        </th>
                        <td>
                            <time title="@WebConsoleDisplayFormatter.FormatExactTime(stack.LastUpdate)">
                                @WebConsoleDisplayFormatter.FormatRelativeTime(stack.LastUpdate, "No updates")
                            </time>
                        </td>
                        <td>@(stack.ResourceCount?.ToString() ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
