@page "/{owner}"
@model Makana.WebConsole.Pages.IndexModel
@using Makana.WebConsole.Models
@{
    ViewData["Title"] = "Dashboard";
    ViewData["NavSection"] = "Dashboard";
}

<section>
    <header>
        <h1>Dashboard</h1>
        <p class="text-light">Overview for <strong>@Model.Owner</strong>.</p>
    </header>

    <div class="row" role="list" aria-label="Owner summary">
        <article class="card col-4" role="listitem">
            <header class="hstack justify-between items-center">
                <h3>Projects</h3>
                <span class="badge">@Model.ProjectCount</span>
            </header>
            <p class="text-light">Distinct Pulumi projects for this owner.</p>
        </article>
        <article class="card col-4" role="listitem">
            <header class="hstack justify-between items-center">
                <h3>Stacks</h3>
                <span class="badge">@Model.Context.SelectedOwnerStacks.Count</span>
            </header>
            <p class="text-light">Stacks currently visible in this workspace.</p>
        </article>
        <article class="card col-4" role="listitem">
            <header class="hstack justify-between items-center">
                <h3>Resources</h3>
                <span class="badge">@Model.ResourceCount</span>
            </header>
            <p class="text-light">Tracked resources across the selected owner.</p>
        </article>
    </div>
</section>

<section>
    <h2>Recent stacks</h2>
    @if (Model.RecentStacks.Count == 0)
    {
        <article class="card">
            <p>No stacks yet for this owner.</p>
        </article>
    }
    else
    {
        <div class="table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Project</th>
                        <th scope="col">Stack</th>
                        <th scope="col">Last update</th>
                        <th scope="col">Resources</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var stack in Model.RecentStacks)
                {
                    var stackPath = ConsoleRoutePaths.Stack(Model.Owner ?? string.Empty, stack.ProjectName, stack.StackName);
                    <tr>
                        <td>@stack.ProjectName</td>
                        <th scope="row">
                            <a href="@stackPath">@stack.StackName</a>
                        </th>
                        <td>
                            <time title="@WebConsoleDisplayFormatter.FormatExactTime(stack.LastUpdate)">
                                @WebConsoleDisplayFormatter.FormatRelativeTime(stack.LastUpdate, "No updates")
                            </time>
                        </td>
                        <td>@(stack.ResourceCount?.ToString() ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
