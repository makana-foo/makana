@page "/"
@model Makana.WebConsole.Pages.SplashModel
@{
    ViewData["Title"] = "Makana";
    ViewData["HideChrome"] = true;
    ViewData["BodyClass"] = "splash-body";
}

<section class="splash-page" aria-labelledby="splash-title">
    <div class="splash-page__hero">
        <p class="splash-page__eyebrow">Pulumi-compatible infrastructure control plane</p>
        <h1 id="splash-title">Makana</h1>
        <p class="splash-page__lede">
            Point the Pulumi CLI at Makana for local development, or reset back to the regular Pulumi service with a clean login.
        </p>
        <div class="splash-page__actions">
            @if (Model.IsAuthenticated)
            {
                <a class="button" href="@Model.DashboardUrl">Dashboard</a>
            }
            else
            {
                <a class="button" asp-page="/Login">Sign in</a>
            }
        </div>
    </div>

    <div class="splash-page__grid">
        <article class="splash-command-card">
            <header class="splash-command-card__header">
                <div>
                    <p class="splash-command-card__label">For Makana</p>
                    <h2>Use the local Makana endpoints</h2>
                </div>
            </header>
            <pre class="splash-command-card__code copyme"><code id="makana-command" class="language-powershell">@Model.MakanaLoginCommand</code></pre>
        </article>

        <article class="splash-command-card">
            <header class="splash-command-card__header">
                <div>
                    <p class="splash-command-card__label">For regular Pulumi</p>
                    <h2>Reset back to the default service</h2>
                </div>
            </header>
            <pre class="splash-command-card__code copyme"><code id="pulumi-command" class="language-powershell">@Model.PulumiLoginCommand</code></pre>
        </article>
    </div>

    <footer class="splash-page__footer" aria-labelledby="splash-disclaimer-title">
        <p id="splash-disclaimer-title" class="splash-page__footer-title">Disclaimer</p>
        <p class="splash-page__footer-copy">
            The Makana project is not associated with or endorsed by Pulumi Corporation. Pulumi is a registered trademark of Pulumi Corporation.
        </p>
    </footer>
</section>
