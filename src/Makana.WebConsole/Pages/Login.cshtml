@page
@model Makana.WebConsole.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["HideChrome"] = true;
    var returnUrl = Request.Query["returnUrl"].ToString();
    var owner = Model.ResolvedOwner;
}

<section class="auth-shell" aria-labelledby="signin-heading">
    <article class="card">
        <header>
            <h1 id="signin-heading">Sign In</h1>
            <p class="text-light">
                @(string.IsNullOrWhiteSpace(owner)
                    ? "Use your work email to discover organization SSO or choose a direct sign-in option."
                    : "Choose a sign-in option for the selected owner. Makana never asks for your password directly.")
            </p>
        </header>

        @if (!string.IsNullOrWhiteSpace(owner) && Model.OrganizationLogin is not null)
        {
            <div role="status">
                <strong>@(Model.OrganizationLogin.DisplayName ?? owner)</strong>
                routes through organization SSO in
                <code>@Model.OrganizationLogin.Mode</code>
                mode.
            </div>
        }

        @if (string.IsNullOrWhiteSpace(owner))
        {
            <form method="post" asp-page-handler="Discover" hx-boost="false" class="auth-provider-form">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <label data-field>
                    Work email
                    <input asp-for="Email"
                           type="email"
                           autocomplete="email"
                           placeholder="you@company.com" />
                </label>
                <span asp-validation-for="Email" class="text-danger"></span>
                <button type="submit">Find organization sign-in</button>
            </form>
        }

        <form method="post" asp-page-handler="SignIn" hx-boost="false" class="auth-provider-form">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            @if (!string.IsNullOrWhiteSpace(owner))
            {
                <input type="hidden" name="owner" value="@owner" />
            }
            <div class="auth-provider-list" role="list" aria-label="Available sign-in providers">
                @foreach (var provider in Model.Providers)
                {
                    <button class="auth-provider-button" type="submit" name="provider" value="@provider.Id">
                        <span class="auth-provider-button__badge" aria-hidden="true">@provider.BadgeText</span>
                        <span class="auth-provider-button__label">@provider.ButtonLabel</span>
                        <span class="auth-provider-button__meta" aria-hidden="true">@provider.DisplayName</span>
                    </button>
                }
            </div>
        </form>

        <p class="auth-provider-note text-light">
            Authentication is delegated to Makana's shared identity service and its upstream identity methods.
        </p>
    </article>
</section>
