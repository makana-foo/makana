@page
@model Makana.WebConsole.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["HideChrome"] = true;
    var returnUrl = Request.Query["returnUrl"].ToString();
}

<section aria-labelledby="signin-heading">
    <article class="card">
        <header>
            <h1 id="signin-heading">Sign In</h1>
            <p class="text-light">Authentication is delegated to the configured OIDC provider.</p>
        </header>

        <form method="post" asp-page-handler="SignIn">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="vstack">
                <label data-field>
                    Email or Username
                    <input id="emailOrUsername" name="emailOrUsername" type="text" autocomplete="username" disabled />
                </label>

                <label data-field>
                    Password
                    <input id="password" name="password" type="password" autocomplete="current-password" disabled />
                </label>
            </div>

            <footer class="hstack justify-end mt-4">
                <button type="submit">Continue to sign in</button>
            </footer>
        </form>
    </article>
</section>
