@page
@model Makana.WebConsole.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["HideChrome"] = true;
    var returnUrl = Request.Query["returnUrl"].ToString();
}

<section class="auth-shell" aria-labelledby="signin-heading">
    <article class="card">
        <header>
            <h1 id="signin-heading">Sign In</h1>
            <p class="text-light">Choose an OpenID Connect sign-in option. Makana never asks for your password directly.</p>
        </header>

        <form method="post" asp-page-handler="SignIn" hx-boost="false" class="auth-provider-form">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="auth-provider-list" role="list" aria-label="Available sign-in providers">
                @foreach (var provider in Model.Providers)
                {
                    <button class="auth-provider-button" type="submit" name="provider" value="@provider.Id">
                        <span class="auth-provider-button__badge" aria-hidden="true">@provider.BadgeText</span>
                        <span class="auth-provider-button__label">@provider.ButtonLabel</span>
                        <span class="auth-provider-button__meta" aria-hidden="true">@provider.DisplayName</span>
                    </button>
                }
            </div>
        </form>

        <p class="auth-provider-note text-light">
            Authentication is delegated to the configured OIDC provider and its upstream identity methods.
        </p>
    </article>
</section>
