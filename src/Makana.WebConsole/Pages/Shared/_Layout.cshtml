@using System.Text.Json
@using Makana.WebConsole.Components
@using Makana.WebConsole.Models
@inject Makana.WebConsole.Services.ConsoleContextService ConsoleContextService
@inject IWebHostEnvironment WebHostEnvironment

@{
    var hideChrome = ViewData["HideChrome"] as bool? == true;
    var activeSection = ViewData["NavSection"] as string ?? string.Empty;
    var navContext = ConsoleNavigationContext.Empty;

    if (!hideChrome)
    {
        navContext = await ConsoleContextService.GetContextAsync(Context, Context.RequestAborted);
    }

    var themeOptions = navContext.User?.AvailableThemes ?? [];
    var preferredTheme = navContext.User?.Theme ?? "default";
    var themeStylesheetPath = themeOptions.FirstOrDefault(option =>
        string.Equals(option.Id, preferredTheme, StringComparison.Ordinal))?.StylesheetPath
        ?? "/css/themes/default.css";
    var accountSettingsHref = !string.IsNullOrWhiteSpace(navContext.PersonalOwner)
        ? Url.Page("/Settings/Index", values: new { owner = navContext.PersonalOwner }) ?? "#"
        : "#";
    var themeConfigJson = JsonSerializer.Serialize(new
    {
        initialTheme = preferredTheme,
        defaultTheme = "default",
        defaultStylesheetPath = "/css/themes/default.css",
        availableThemes = themeOptions,
        updateUrl = User.Identity?.IsAuthenticated == true ? "/api/user/theme" : null,
        modeStorageKey = "makana:theme-mode"
    }, new JsonSerializerOptions(JsonSerializerDefaults.Web));
    var pageScriptRelativePath = ViewContext.View.Path is { Length: > 0 } viewPath
        ? $"{viewPath.TrimStart('/')}.js"
        : null;
    var pageScriptPath = !string.IsNullOrWhiteSpace(pageScriptRelativePath)
        && WebHostEnvironment.WebRootFileProvider.GetFileInfo(pageScriptRelativePath).Exists
            ? $"~/{pageScriptRelativePath}"
            : null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="htmx-config" historyCacheSize="32" />
    <title>@ViewData["Title"] - Makana Console</title>
    <script>
            window.makanaThemeConfig = @Html.Raw(themeConfigJson);
            (() => {
                const config = window.makanaThemeConfig ?? {};
                const theme = typeof config.initialTheme === "string" && config.initialTheme.length > 0
                    ? config.initialTheme
                    : (typeof config.defaultTheme === "string" && config.defaultTheme.length > 0 ? config.defaultTheme : "default");
                const modeStorageKey = typeof config.modeStorageKey === "string" && config.modeStorageKey.length > 0
                    ? config.modeStorageKey
                    : "makana:theme-mode";
                let mode = null;
                try {
                    const storedMode = window.localStorage.getItem(modeStorageKey);
                    if (storedMode === "light" || storedMode === "dark") {
                        mode = storedMode;
                    }
                } catch {
                    mode = null;
                }

                if (mode !== "light" && mode !== "dark") {
                    mode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }

                const token = theme === "island" ? `island-${mode}` : mode;
                document.documentElement.style.colorScheme = mode;
                document.documentElement.setAttribute("data-theme-family", theme);
                document.documentElement.setAttribute("data-theme-mode", mode);
                document.documentElement.setAttribute("data-theme", token);
            })();
    </script>
    <link rel="stylesheet" href="~/lib/oat/oat.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="@themeStylesheetPath" id="makana-theme-stylesheet" data-theme-stylesheet />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Makana.WebConsole.styles.css" />
</head>

<body class="@ViewData["BodyClass"]">
    <component type="typeof(ShellIconSprite)" render-mode="Static" />
    @if (hideChrome)
    {
        <main class="container">
            <div id="console-page">
                @RenderBody()
            </div>
        </main>
    }
    else
    {
        <div data-sidebar-layout="always" hx-boost="true" hx-target="#console-page" hx-select="#console-page"
             hx-select-oob="#console-sidebar,#page-scripts" hx-swap="outerHTML transition:true show:window:top"
             hx-push-url="true">
            <nav data-topnav aria-label="Console toolbar">
                <a hx-disable class="button outline large icon" asp-page="/Splash" aria-label="Makana homepage">M</a>
                <button type="button"
                        class="outline small icon"
                        data-sidebar-toggle
                        data-sidebar-expand-toggle
                        data-tooltip-placement="right"
                        aria-label="Expand sidebar"
                        title="Expand sidebar">
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 28 28" width="16" height="16">
                        <use href="#shell-icon-sidebar-expand"></use>
                    </svg>
                </button>
                <div class="hstack justify-between w-100">
                    <div class="vstack gap-1">
                        <strong>@(ViewData["Title"] ?? "Makana Console")</strong>
                        @if (!string.IsNullOrWhiteSpace(navContext.SelectedOwner))
                        {
                            <small class="text-light">Owner: @navContext.SelectedOwner</small>
                        }
                    </div>
                    <div class="hstack justify-end">
                        <button type="button" class="outline large icon" data-theme-mode-toggle data-tooltip-placement="bottom"
                                aria-label="Switch color mode" title="Switch color mode">
                            <svg aria-hidden="true" focusable="false" viewBox="0 0 32 32" width="16" height="16">
                                <use href="#shell-icon-theme-light" data-theme-mode-icon-use></use>
                            </svg>
                        </button>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var displayName = navContext.User?.Name
                                ?? navContext.User?.GitHubLogin
                                ?? User.Identity.Name
                                ?? "signed-in";
                            var avatarPath = ConsoleAvatarPaths.ForUser(navContext.User);
                            <ot-dropdown>
                                <button type="button" class="outline large flex items-center gap-2" popovertarget="user-menu"
                                        aria-label="Open account menu" data-account-menu-trigger>
                                    @if (!string.IsNullOrWhiteSpace(avatarPath))
                                    {
                                        <component type="typeof(ConsoleUserAvatar)" render-mode="Static"
                                                   param-AvatarPath="avatarPath" param-AltText="@($"Avatar for {displayName}")"
                                                   param-Size="40" />
                                    }
                                    <span class="text-light">@displayName</span>
                                    <component type="typeof(DropdownChevron)" render-mode="Static" />
                                </button>
                                <menu popover id="user-menu">
                                    <a role="menuitem" href="@accountSettingsHref">Account settings</a>
                                    <form method="post" asp-page="/Login" asp-page-handler="SignOut" hx-boost="false">
                                        <button type="submit" role="menuitem">Logout</button>
                                    </form>
                                </menu>
                            </ot-dropdown>
                        }
                        else
                        {
                            <a class="button outline large" asp-page="/Login">Login</a>
                        }
                    </div>
                </div>
            </nav>

            <component type="typeof(ConsoleSidebar)" render-mode="Static" param-Context="navContext"
                       param-ActiveSection="activeSection" />

            <main>
                <div id="console-page" class="container">
                    @RenderBody()
                </div>
            </main>
        </div>
    }

    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script type="module" src="~/lib/oat/oat.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <div id="page-scripts">
        @if (pageScriptPath is not null)
        {
            <script src="@pageScriptPath" asp-append-version="true"></script>
        }
        @await RenderSectionAsync("Scripts", required: false)
    </div>
</body>

</html>
