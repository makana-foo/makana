@using Makana.WebConsole.Components
@using Makana.WebConsole.Models
@inject Makana.WebConsole.Services.ConsoleContextService ConsoleContextService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Makana Console</title>
    <script>
        (() => {
            const theme = localStorage.getItem("theme");
            if (theme === "light" || theme === "dark") {
                document.documentElement.style.colorScheme = theme;
                document.documentElement.setAttribute("data-theme", theme);
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/oat/oat.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Makana.WebConsole.styles.css" />
</head>
<body class="@ViewData["BodyClass"]">
@{
    var hideChrome = ViewData["HideChrome"] as bool? == true;
    var activeSection = ViewData["NavSection"] as string ?? string.Empty;
    var navContext = ConsoleNavigationContext.Empty;

    if (!hideChrome)
    {
        navContext = await ConsoleContextService.GetContextAsync(Context, Context.RequestAborted);
    }
}

@if (hideChrome)
{
    <main class="container">
        @RenderBody()
    </main>
}
else
{
    <div data-sidebar-layout="always">
        <nav data-topnav aria-label="Console toolbar">
            <button type="button" class="outline small" data-sidebar-toggle aria-label="Toggle sidebar">Menu</button>
            <div class="hstack justify-between w-100">
                <div>
                    <strong>@(ViewData["Title"] ?? "Makana Console")</strong>
                    @if (!string.IsNullOrWhiteSpace(navContext.SelectedOwner))
                    {
                        <small class="text-light">Owner: @navContext.SelectedOwner</small>
                    }
                </div>
                <div class="hstack">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var displayName = navContext.User?.Name
                            ?? navContext.User?.GitHubLogin
                            ?? User.Identity.Name
                            ?? "signed-in";
                        var avatarPath = ConsoleAvatarPaths.ForUser(navContext.User);
                        if (!string.IsNullOrWhiteSpace(avatarPath))
                        {
                            <component type="typeof(ConsoleUserAvatar)"
                                       render-mode="Static"
                                       param-AvatarPath="avatarPath"
                                       param-AltText="@($"Avatar for {displayName}")"
                                       param-Size="28" />
                        }
                        <small class="text-light">@displayName</small>
                        <form method="post" asp-page="/Login" asp-page-handler="SignOut">
                            <button type="submit" class="outline small">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="button outline small" asp-page="/Login">Login</a>
                    }
                </div>
            </div>
        </nav>

        <component type="typeof(ConsoleSidebar)"
                   render-mode="Static"
                   param-Context="navContext"
                   param-ActiveSection="activeSection" />

        <main>
            <div class="container">
                @RenderBody()
            </div>
        </main>
    </div>
}

    <script type="module" src="~/lib/oat/oat.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
