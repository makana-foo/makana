@page "{org?}/{project?}"
@model Makana.WebConsole.Pages.Projects.IndexModel
@{
    ViewData["Title"] = $"Project {Model.Project}";
}

<header>
    <h1>Project: @Model.Project</h1>
    <p>
        <a asp-page="/Organizations/Index" asp-route-org="@Model.Org">Organization @Model.Org</a>
    </p>
</header>

<section>
    <h2>Stacks</h2>
    @if (Model.Stacks.Count == 0)
    {
        <p>No stacks found for this project.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th scope="col">Stack</th>
                    <th scope="col">Resources</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var stack in Model.Stacks)
            {
                <tr>
                    <th scope="row">
                        <a asp-page="/Stacks/Index" asp-route-org="@Model.Org" asp-route-project="@Model.Project" asp-route-stack="@stack.StackName">@stack.StackName</a>
                    </th>
                    <td>@(stack.ResourceCount?.ToString() ?? "-")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
