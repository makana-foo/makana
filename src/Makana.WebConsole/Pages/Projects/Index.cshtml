@page "/{owner}/projects/{project}"
@model Makana.WebConsole.Pages.Projects.IndexModel
@using Makana.WebConsole.Models
@{
    ViewData["Title"] = $"Project {Model.Project}";
    var header = new ConsolePageHeaderViewModel(
        $"Project: {Model.Project}",
        BackHref: $"/{Uri.EscapeDataString(Model.Owner)}/organization",
        BackLabel: $"Organization {Model.Owner}");
}

<partial name="_ConsolePageHeader" model="header" />

<section>
    <h2>Stacks</h2>
    @if (Model.Stacks.Count == 0)
    {
        <partial name="_ConsoleEmptyState" model='new ConsoleEmptyStateViewModel("No stacks found for this project.")' />
    }
    else
    {
        <div class="table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Stack</th>
                        <th scope="col">Resources</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var stack in Model.Stacks)
                {
                    var stackPath = ConsoleRoutePaths.Stack(Model.Owner, Model.Project, stack.StackName);
                    <tr>
                        <th scope="row">
                            <a href="@stackPath">@stack.StackName</a>
                        </th>
                        <td>@(stack.ResourceCount?.ToString() ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
