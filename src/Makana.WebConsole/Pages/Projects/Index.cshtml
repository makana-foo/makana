@page "/{owner}/projects/{project}"
@model Makana.WebConsole.Pages.Projects.IndexModel
@using Makana.WebConsole.Models
@{
    ViewData["Title"] = $"Project {Model.Project}";
}

<header>
    <h1>Project: @Model.Project</h1>
    <p>
        <a asp-page="/Organizations/Index" asp-route-owner="@Model.Owner">Organization @Model.Owner</a>
    </p>
</header>

<section>
    <h2>Stacks</h2>
    @if (Model.Stacks.Count == 0)
    {
        <article class="card">
            <p>No stacks found for this project.</p>
        </article>
    }
    else
    {
        <div class="table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Stack</th>
                        <th scope="col">Resources</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var stack in Model.Stacks)
                {
                    var stackPath = ConsoleRoutePaths.Stack(Model.Owner, Model.Project, stack.StackName);
                    <tr>
                        <th scope="row">
                            <a href="@stackPath">@stack.StackName</a>
                        </th>
                        <td>@(stack.ResourceCount?.ToString() ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
