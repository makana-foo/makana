@page
@model Makana.WebConsole.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
    ViewData["NavSection"] = "Settings";
}

<section>
    <header>
        <h1>Settings</h1>
        <p class="text-light">Current account and owner context.</p>
    </header>

    <article class="card">
        <header>
            <h3>Identity</h3>
            <p class="text-light">Resolved from the Makana API and current OIDC session.</p>
        </header>
        @if (Model.Context.User is null)
        {
            <div role="alert" data-variant="error">
                <strong>Unavailable.</strong> Unable to load account details from the API.
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-6">
                    <label data-field>
                        User
                        <input type="text" value="@Model.Context.User.Name" readonly />
                    </label>
                </div>
                <div class="col-6">
                    <label data-field>
                        Login
                        <input type="text" value="@Model.Context.User.GitHubLogin" readonly />
                    </label>
                </div>
                <div class="col-6">
                    <label data-field>
                        Email
                        <input type="text" value="@(Model.Context.User.Email ?? "not provided")" readonly />
                    </label>
                </div>
                <div class="col-6">
                    <label data-field>
                        Selected owner
                        <input type="text" value="@(Model.Owner ?? "none")" readonly />
                    </label>
                </div>
            </div>
        }
    </article>
</section>
