@page "/{owner}/resources"
@model Makana.WebConsole.Pages.Resources.IndexModel
@using Makana.WebConsole.Models
@{
    ViewData["Title"] = "Resources";
    ViewData["NavSection"] = "Resources";
}

<section>
    <header>
        <h1>Resources</h1>
        <p class="text-light">Resource counts by stack for <strong>@Model.Owner</strong>. Total: <strong>@Model.TotalResources</strong></p>
    </header>

    @if (Model.Stacks.Count == 0)
    {
        <article class="card">
            <p>No stacks found for this owner.</p>
        </article>
    }
    else
    {
        <div class="table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Project</th>
                        <th scope="col">Stack</th>
                        <th scope="col">Resources</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var stack in Model.Stacks)
                {
                    var stackPath = ConsoleRoutePaths.Stack(Model.Owner ?? string.Empty, stack.ProjectName, stack.StackName);
                    <tr>
                        <td>@stack.ProjectName</td>
                        <th scope="row">
                            <a href="@stackPath">@stack.StackName</a>
                        </th>
                        <td>@(stack.ResourceCount?.ToString() ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
