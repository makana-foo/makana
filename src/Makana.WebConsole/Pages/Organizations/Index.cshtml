@page "/{owner}/organization"
@model Makana.WebConsole.Pages.Organizations.IndexModel
@{
    ViewData["Title"] = $"Organization {Model.Owner}";
}

<header>
    <h1>Organization: @Model.Owner</h1>
    <p class="text-light"><a asp-page="/Index" asp-route-owner="@Model.Owner">Back to dashboard</a></p>
</header>

<section>
    <h2>Projects</h2>
    @if (Model.Projects.Count == 0)
    {
        <article class="card">
            <p>No projects found for this organization.</p>
        </article>
    }
    else
    {
        <div class="table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Project</th>
                        <th scope="col">Stacks</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var project in Model.Projects)
                {
                    <tr>
                        <th scope="row">
                            <a asp-page="/Projects/Index" asp-route-owner="@Model.Owner" asp-route-project="@project.ProjectName">@project.ProjectName</a>
                        </th>
                        <td>@project.StackCount</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
