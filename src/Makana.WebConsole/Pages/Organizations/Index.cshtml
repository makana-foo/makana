@page "/{owner}/organization"
@model Makana.WebConsole.Pages.Organizations.IndexModel
@{
    ViewData["Title"] = $"Organization {Model.Owner}";
    var header = new ConsolePageHeaderViewModel(
        $"Organization: {Model.Owner}",
        BackHref: $"/{Uri.EscapeDataString(Model.Owner)}",
        BackLabel: "Back to dashboard");
}

<partial name="_ConsolePageHeader" model="header" />

<section>
    <h2>Projects</h2>
    @if (Model.Projects.Count == 0)
    {
        <partial name="_ConsoleEmptyState" model='new ConsoleEmptyStateViewModel("No projects found for this organization.")' />
    }
    else
    {
        <div class="table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Project</th>
                        <th scope="col">Stacks</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var project in Model.Projects)
                {
                    <tr>
                        <th scope="row">
                            <a asp-page="/Projects/Index" asp-route-owner="@Model.Owner" asp-route-project="@project.ProjectName">@project.ProjectName</a>
                        </th>
                        <td>@project.StackCount</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
