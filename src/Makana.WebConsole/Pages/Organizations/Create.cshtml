@page "/{owner}/organizations/new"
@model Makana.WebConsole.Pages.Organizations.CreateModel
@using Makana.WebConsole.Models
@{
    ViewData["Title"] = "Create organization";
    var pageHeader = new ConsolePageHeaderViewModel(
        "Create organization",
        "Start the organization creation flow without leaving the current owner-scoped console shell.");
}

<section class="settings-page">
    <partial name="_ConsolePageHeader" model="pageHeader" />

    <article class="card">
        <header>
            <h3>Organization details</h3>
            <p class="text-light">
                Create a new organization from the current owner-scoped shell. Makana will derive the owner slug server-side.
            </p>
        </header>

        @if (Model.CreationAttempted)
        {
            <div role="status" data-variant="info">
                <strong>Submission attempted.</strong> Makana validated this request against the organization API.
            </div>
        }
        else
        {
            <div role="status" data-variant="info">
                The owner slug preview is informational. The API remains authoritative for normalization and uniqueness.
            </div>
        }

        <form method="post" class="vstack gap-3">
            <label data-field>
                Organization name
                <input asp-for="OrganizationName"
                       autocomplete="organization"
                       placeholder="acme-platform"
                       aria-describedby="organization-create-help" />
            </label>
            <p id="organization-create-help" class="text-light">
                Preview owner slug: <strong>@(string.IsNullOrWhiteSpace(Model.PreviewSlug) ? "unavailable" : Model.PreviewSlug)</strong>
            </p>
            <div asp-validation-summary="ModelOnly" class="text-light"></div>
            <div class="hstack gap-2">
                <button type="submit">Create organization</button>
                <a class="button outline" asp-page="/Stacks/Index" asp-route-owner="@Model.Owner">Cancel</a>
            </div>
        </form>
    </article>
</section>
