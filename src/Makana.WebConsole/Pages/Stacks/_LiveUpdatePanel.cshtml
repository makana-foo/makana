@model Makana.WebConsole.Models.StackLivePanelViewModel

<article id="live-update-panel" class="card">
    <div id="live-update-panel-header">
        <partial name="_LiveUpdateHeader" model="Model" />
    </div>

    <ot-tabs data-stack-tab-state="@($"{Model.Org}:{Model.Project}:{Model.Stack}:{Model.UpdateId ?? "none"}:primary")">
        <div role="tablist" class="stack-tablist">
            <button type="button" role="tab" aria-selected="true">Changes</button>
            <button type="button" role="tab">Timeline</button>
            <button type="button" role="tab">Configuration</button>
            <button type="button" role="tab">Outputs</button>
            <button type="button" role="tab">Resources</button>
            <button type="button" role="tab">Metadata</button>
        </div>

        <div role="tabpanel">
            <div id="live-update-panel-changes">
                <partial name="_LiveUpdateChangesTab" model="Model" />
            </div>
        </div>

        <div role="tabpanel">
            <partial name="_LiveUpdateTimelineTab" model="Model" />
        </div>

        <div role="tabpanel">
            <div id="live-update-panel-configuration">
                <partial name="_LiveUpdateConfigurationTab" model="Model" />
            </div>
        </div>

        <div role="tabpanel">
            <div id="live-update-panel-outputs">
                <partial name="_LiveUpdateOutputsTab" model="Model" />
            </div>
        </div>

        <div role="tabpanel">
            <div id="live-update-panel-resources">
                <partial name="_LiveUpdateResourcesTab" model="Model" />
            </div>
        </div>

        <div role="tabpanel">
            <div id="live-update-panel-metadata">
                <partial name="_LiveUpdateMetadataTab" model="Model" />
            </div>
        </div>
    </ot-tabs>
</article>
