@page "/{owner}/stacks"
@model Makana.WebConsole.Pages.Stacks.IndexModel
@{
    ViewData["Title"] = "Stacks";
    ViewData["NavSection"] = "Stacks";
}

<section>
    <header>
        <h1>Stacks</h1>
        <p class="text-light">Projects for <strong>@Model.Owner</strong>.</p>
    </header>

    <component
        type="typeof(Makana.WebConsole.Components.ProjectAccordionList)"
        render-mode="Static"
        param-Projects="Model.Projects"
        param-SelectedOwner="@(Model.Owner ?? string.Empty)" />
</section>
