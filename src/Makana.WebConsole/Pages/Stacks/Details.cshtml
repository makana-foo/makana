@page "/{owner}/stacks/{project}/{stack}"
@model Makana.WebConsole.Pages.Stacks.DetailsModel
@using Makana.WebConsole.Models
@{
    ViewData["Title"] = $"Stack {Model.Stack}";
    ViewData["NavSection"] = "Stacks";
    var stackPagePath = string.IsNullOrWhiteSpace(Model.LivePanel.SelectedRunType) || string.IsNullOrWhiteSpace(Model.LivePanel.SelectedRouteReference)
        ? ConsoleRoutePaths.Stack(Model.Owner, Model.Project, Model.Stack)
        : ConsoleRoutePaths.StackRun(Model.Owner, Model.Project, Model.Stack, Model.LivePanel.SelectedRunType, Model.LivePanel.SelectedRouteReference);
    var pageHeader = new ConsolePageHeaderViewModel(
        $"Stack: {Model.Stack}",
        $"Owner: {Model.Owner}");
    var stackMetadataItems = Model.LivePanel.StackMetadata is null
        ? []
        : new[]
        {
            new ConsoleDetailItem("Version", Model.LivePanel.StackMetadata.Version.ToString()),
            new ConsoleDetailItem(
                "Active update",
                string.IsNullOrWhiteSpace(Model.LivePanel.StackMetadata.ActiveUpdate) ? "None" : Model.LivePanel.StackMetadata.ActiveUpdate)
        };
}

<section class="stack-details-page">
    <nav class="stack-details-page__breadcrumb" aria-label="Breadcrumb">
        <ol class="stack-breadcrumb">
            <li><a asp-page="/Stacks/Index" asp-route-owner="@Model.Owner">Stacks</a></li>
            <li aria-hidden="true">/</li>
            <li><a asp-page="/Projects/Index" asp-route-owner="@Model.Owner" asp-route-project="@Model.Project">@Model.Project</a></li>
            <li aria-hidden="true">/</li>
            <li>
                <a href="@ConsoleRoutePaths.Stack(Model.Owner, Model.Project, Model.Stack)" aria-current="page">
                    <strong>@Model.Stack</strong>
                </a>
            </li>
        </ol>
    </nav>

    <partial name="_ConsolePageHeader" model="pageHeader" />

    @if (Model.LivePanel.StackMetadata is null)
    {
        <article class="card">
            <div role="alert" data-variant="error">
                <strong>Unavailable.</strong> Unable to load stack details.
            </div>
        </article>
    }
    else
    {
        <section id="stack-live-panel-container"
                 data-stack-view-key="@($"{Model.Owner}:{Model.Project}:{Model.Stack}:{Model.LivePanel.UpdateId ?? "none"}")"
                 data-live-update-owner="@Model.Owner"
                 data-live-update-project="@Model.Project"
                 data-live-update-stack="@Model.Stack"
                 data-live-update-id="@Model.LivePanel.UpdateId"
                 data-live-update-enabled="@(Model.EnableLiveRefresh ? "true" : "false")"
                 data-live-update-show-history="@(Model.LivePanel.ShowUpdateHistory ? "true" : "false")"
                 data-live-update-view-url="@Model.StackUpdateViewUrl"
                 data-live-update-hub-url="@Model.StackUpdateHubUrl"
                 data-live-update-access-token="@Model.ApiAccessToken"
                 data-live-update-route-url="@stackPagePath">
            <partial name="_LiveUpdateState" model="Model.LivePanel" />

            @if (Model.LivePanel.ShowUpdateHistory)
            {
                <div id="stack-latest-update">
                    <partial name="_StackLatestUpdateCard" model="Model.LivePanel" />
                </div>

                <div id="stack-update-history">
                    <partial name="_StackUpdateHistory" model="Model.LivePanel" />
                </div>
            }
            else
            {
                <partial name="_LiveUpdatePanel" model="Model.LivePanel" />
            }
        </section>

        <article class="card">
            <header>
                <h3>Stack metadata</h3>
            </header>
            <component type="typeof(Makana.WebConsole.Components.ConsoleDetailGrid)"
                       render-mode="Static"
                       param-Items="stackMetadataItems" />
        </article>

        <article class="card">
            <header>
                <h3>Tags</h3>
            </header>
            @if (Model.LivePanel.StackMetadata.Tags is null || Model.LivePanel.StackMetadata.Tags.Count == 0)
            {
                <p>No tags set on this stack.</p>
            }
            else
            {
                <div class="table">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Key</th>
                                <th scope="col">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.LivePanel.StackMetadata.Tags.OrderBy(kvp => kvp.Key, StringComparer.Ordinal))
                            {
                                <tr>
                                    <th scope="row"><code>@entry.Key</code></th>
                                    <td><code>@entry.Value</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    }
</section>
