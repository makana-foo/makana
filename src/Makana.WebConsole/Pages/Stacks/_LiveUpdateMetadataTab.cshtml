@using Makana.WebConsole.Models
@model Makana.WebConsole.Models.StackLivePanelViewModel
@{
    var overviewItems = new[]
    {
        new ConsoleDetailItem("Kind", Model.DisplayKindLabel),
        new ConsoleDetailItem("Version", Model.DisplayVersion?.ToString() ?? "n/a"),
        new ConsoleDetailItem("Message", Model.DisplayMessage ?? "n/a")
    };
    var summaryItems = new[]
    {
        new ConsoleDetailItem("Preview", Model.IsPreview ? "Yes" : "No"),
        new ConsoleDetailItem("Resource count", Model.DisplayResourceCount?.ToString() ?? "n/a"),
        new ConsoleDetailItem("Result", Model.StatusText)
    };
    var timingItems = new[]
    {
        new ConsoleDetailItem("Started", Model.DisplayStartedExactText),
        new ConsoleDetailItem("Completed", Model.DisplayCompletedExactText),
        new ConsoleDetailItem("Maybe corrupt", (Model.UpdateView?.Summary?.MaybeCorrupt == true) ? "Yes" : "No")
    };
}

@if (!string.IsNullOrWhiteSpace(Model.DisplayKind) || Model.DisplayVersion is not null || !string.IsNullOrWhiteSpace(Model.DisplayMessage))
{
    <div class="stack-live-metadata">
        <component type="typeof(Makana.WebConsole.Components.ConsoleDetailGrid)"
                   render-mode="Static"
                   param-Items="overviewItems" />
    </div>
}

@if (Model.DisplayStartTime is not null || Model.DisplayEndTime is not null || Model.DisplayResourceCount is not null || Model.UpdateView?.Summary is not null)
{
    <div class="stack-live-metadata">
        <component type="typeof(Makana.WebConsole.Components.ConsoleDetailGrid)"
                   render-mode="Static"
                   param-Items="summaryItems" />
        <component type="typeof(Makana.WebConsole.Components.ConsoleDetailGrid)"
                   render-mode="Static"
                   param-Items="timingItems" />
    </div>
}
