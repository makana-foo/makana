@using Makana.WebConsole.Models
@model Makana.WebConsole.Models.StackLivePanelViewModel
<div class="stack-live-metadata">
    <dl class="console-detail-grid">
        <div class="console-detail-grid__item">
            <dt>Kind</dt>
            <dd id="live-update-meta-kind">@Model.DisplayKindLabel</dd>
        </div>
        <div class="console-detail-grid__item">
            <dt>Version</dt>
            <dd id="live-update-meta-version">@(Model.DisplayVersion?.ToString() ?? "n/a")</dd>
        </div>
        <div class="console-detail-grid__item">
            <dt>Message</dt>
            <dd id="live-update-meta-message">@(Model.DisplayMessage ?? "n/a")</dd>
        </div>
    </dl>
</div>

<div class="stack-live-metadata">
    <dl class="console-detail-grid">
        <div class="console-detail-grid__item">
            <dt>Preview</dt>
            <dd id="live-update-meta-preview">@(Model.IsPreview ? "Yes" : "No")</dd>
        </div>
        <div class="console-detail-grid__item">
            <dt>Resource count</dt>
            <dd id="live-update-meta-resource-count">@(Model.DisplayResourceCount?.ToString() ?? "n/a")</dd>
        </div>
        <div class="console-detail-grid__item">
            <dt>Result</dt>
            <dd id="live-update-meta-result">@Model.StatusText</dd>
        </div>
    </dl>

    <dl class="console-detail-grid">
        <div class="console-detail-grid__item">
            <dt>Started</dt>
            <dd id="live-update-meta-started">@Model.DisplayStartedExactText</dd>
        </div>
        <div class="console-detail-grid__item">
            <dt>Completed</dt>
            <dd id="live-update-meta-completed">@Model.DisplayCompletedExactText</dd>
        </div>
        <div class="console-detail-grid__item">
            <dt>Maybe corrupt</dt>
            <dd id="live-update-meta-maybe-corrupt">@((Model.UpdateView?.Summary?.MaybeCorrupt == true) ? "Yes" : "No")</dd>
        </div>
    </dl>
</div>
