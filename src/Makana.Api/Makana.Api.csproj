<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AOT Settings -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <WarningsAsErrors>RDG002;IL2026;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056;IL3057;IL3058</WarningsAsErrors>
    <UserSecretsId>0622c73e-66a9-41da-a22b-a97812afe46f</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>../..</DockerfileContext>
    <!-- AOT Settings -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Htmx" Version="1.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Makana.Authentication/Makana.Authentication.csproj" />
    <ProjectReference Include="../CommunityToolkit.Aspire.Litestream/CommunityToolkit.Aspire.Litestream.csproj" />
    <ProjectReference Include="../Makana.ServiceDefaults/Makana.ServiceDefaults.csproj" />
    <ProjectReference Include="../Makana.Api.Data/Makana.Api.Data.csproj" />
    <ProjectReference Include="../Makana.Journaling/Makana.Journaling.csproj" />
    <ProjectReference Include="../Makana.StackUpdates/Makana.StackUpdates.csproj" />
    <ProjectReference Include="../Makana.Compatibility/Makana.Compatibility.csproj" />
  </ItemGroup>
</Project>
