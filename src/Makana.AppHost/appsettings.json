{
  "Cors": {
    "AllowedOrigins": [
      "makana.foo"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "ApiContainer": {
    "PublishAot": true,
    "AotFinalBaseImage": "mcr.microsoft.com/dotnet/runtime-deps:10.0-noble-chiseled",
    "FrameworkDependentFinalBaseImage": "mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra"
  },
  "ApiData": {
    "UsePersistentState": true
  },
  "Dex": {
    "UsePersistentState": true
  },
  "Parameters": {
    "oidc-provider": "dex",
    "oidc-mode": "local",
    "oidc-authority": "https://auth.makana.foo",
    "upstream-oidc-authority": "https://pocketid.makana.foo",
    "oidc-client-id": "makana-web",
    //"oidc-client-secret": "",
    "pocketid-encryption-key": "",
    "pocketid-static-api-key": "",
    "makana-api-db-path": "/tmp/makana/makana.db",
    "makana-litestream-bucket": "makana-dev",
    "makana-litestream-path": "makana/api",
    "makana-litestream-region": "us-east-1",
    "makana-litestream-endpoint": "http://127.0.0.1:3900",
    "makana-litestream-access-key": "garage-access-key",
    "makana-litestream-secret-key": "garage-secret-key",
    "pocketid-litestream-bucket": "makana-dev",
    "pocketid-litestream-path": "makana/auth",
    "pocketid-litestream-region": "us-east-1",
    "pocketid-litestream-endpoint": "http://127.0.0.1:3900",
    "pocketid-litestream-access-key": "garage-access-key",
    "pocketid-litestream-secret-key": "garage-secret-key",
    "app-host": "makana.foo",
    "api-host": "api.makana.foo",
    "auth-host": "auth.makana.foo",
    "app-cert-name": "",
    "api-cert-name": "",
    "auth-cert-name": ""
  }
}
