{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PocketId": {
    "UsePersistentState": true
  },
  "PublicIngress": {
    "AppHost": "app-makana.dev.localhost",
    "ApiHost": "api-makana.dev.localhost",
    "AuthHost": "auth-makana.dev.localhost",
    "HttpsPort": 3443
  },
  "ApiContainer": {
    "PublishAot": false
  },
  "Parameters": {
    "oidc-provider": "dex",
    "oidc-mode": "local",
    "oidc-client-id": "makana-web",
    "oidc-client-secret": "",
    "pocketid-encryption-key": "dev-only-pocketid-encryption-key-change-me-1234567890",
    "pocketid-static-api-key": "dev-only-pocketid-static-api-key-change-me-1234567890",
    "makana-api-db-path": ".data/makana-api/makana.db",
    "makana-litestream-bucket": "makana-dev",
    "makana-litestream-path": "makana/api",
    "makana-litestream-region": "us-east-1",
    "makana-litestream-endpoint": "http://127.0.0.1:3900",
    "makana-litestream-access-key": "garage-access-key",
    "makana-litestream-secret-key": "garage-secret-key",
    "pocketid-litestream-bucket": "makana-dev",
    "pocketid-litestream-path": "makana/auth",
    "pocketid-litestream-region": "us-east-1",
    "pocketid-litestream-endpoint": "http://127.0.0.1:3900",
    "pocketid-litestream-access-key": "garage-access-key",
    "pocketid-litestream-secret-key": "garage-secret-key"
  }
}
